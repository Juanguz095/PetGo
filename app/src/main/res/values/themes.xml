<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.PracticaFinal" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:navigationBarColor">@color/crema</item>
        <item name="android:statusBarColor">@color/crema</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/crema</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
    </style>

    <style name="Theme.PracticaFinal" parent="Base.Theme.PracticaFinal" />

    <style name="Theme.PracticaFinal.MenuOverlay" parent="Theme.PracticaFinal">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="TextAppearance.AdopcionesTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tinta</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="TextAppearance.PetGo.Titulo" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tinta</item>
    </style>
</resources>
