<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Controles que completan el estilo de las tarjetas existentes. -->
    <style name="Widget.PetGo.Button" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/petgo_button_text</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@color/petgo_button_background</item>
        <item name="cornerRadius">11dp</item>
        <item name="strokeColor">@color/tinta</item>
        <item name="strokeWidth">2dp</item>
        <item name="rippleColor">@color/petgo_ripple</item>
    </style>

    <style name="Widget.PetGo.Button.Outlined" parent="Widget.PetGo.Button">
        <item name="backgroundTint">@color/white</item>
    </style>

    <style name="Widget.PetGo.Button.Icon" parent="Widget.PetGo.Button.Outlined">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:gravity">center</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">24dp</item>
        <item name="iconTint">@color/tinta</item>
    </style>

    <style name="Widget.PetGo.EmptyState" parent="">
        <item name="android:background">@drawable/bg_brutal_beige</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textColor">@color/tinta</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingEnd">29dp</item>
        <item name="android:paddingBottom">29dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.PetGo.Photo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.PetGo.CardPhoto" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">18dp</item>
        <item name="cornerSizeTopRight">18dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ThemeOverlay.PetGo.Dialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="colorPrimary">@color/tinta</item>
        <item name="colorOnSurface">@color/tinta</item>
        <item name="colorSurface">@color/crema</item>
        <item name="android:windowBackground">@drawable/bg_dialogo</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.PetGo.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.PetGo.DialogButton</item>
    </style>

    <style name="Widget.PetGo.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textColor">@color/tinta</item>
        <item name="rippleColor">@color/petgo_ripple</item>
    </style>
</resources>
