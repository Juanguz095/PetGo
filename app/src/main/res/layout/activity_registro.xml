<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crema"
    tools:context=".RegistroActivity"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_marginTop="12dp"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@color/crema"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="Volver"
        app:navigationIcon="@drawable/ic_back_cabecera"
        app:titleTextAppearance="@style/TextAppearance.AdopcionesTitle"
        app:title="Registro"
        app:titleTextColor="@color/tinta" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp"
            android:paddingEnd="18dp"
            android:paddingStart="18dp"
            android:paddingTop="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Entra a la manada"
                android:textColor="@color/black"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Ayuda a reunir familias y mascotas."
                android:textColor="@color/texto_suave"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Nombre completo"
                android:textColor="@color/tinta"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_nombre"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_brutal_crema"
                android:gravity="center_vertical"
                android:hint="Tu nombre"
                android:importantForAutofill="no"
                android:inputType="textPersonName"
                android:paddingBottom="5dp"
                android:paddingEnd="15dp"
                android:paddingStart="15dp"
                android:singleLine="true"
                android:textColor="@color/tinta"
                android:textColorHint="@color/texto_suave"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Correo electrónico"
                android:textColor="@color/tinta"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_correo"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_brutal_crema"
                android:gravity="center_vertical"
                android:hint="tucorreo@ejemplo.com"
                android:importantForAutofill="no"
                android:inputType="textEmailAddress"
                android:paddingBottom="5dp"
                android:paddingEnd="15dp"
                android:paddingStart="15dp"
                android:singleLine="true"
                android:textColor="@color/tinta"
                android:textColorHint="@color/texto_suave"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Contraseña"
                android:textColor="@color/tinta"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_contrasena"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_brutal_crema"
                android:gravity="center_vertical"
                android:hint="Mínimo 6 caracteres"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:paddingBottom="5dp"
                android:paddingEnd="15dp"
                android:paddingStart="15dp"
                android:singleLine="true"
                android:textColor="@color/tinta"
                android:textColorHint="@color/texto_suave"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Ciudad"
                android:textColor="@color/tinta"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_ciudad"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_brutal_crema"
                android:gravity="center_vertical"
                android:hint="Tu ciudad"
                android:importantForAutofill="no"
                android:inputType="textPersonName"
                android:paddingBottom="5dp"
                android:paddingEnd="15dp"
                android:paddingStart="15dp"
                android:singleLine="true"
                android:textColor="@color/tinta"
                android:textColorHint="@color/texto_suave"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Confirmar contraseña"
                android:textColor="@color/tinta"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_confirmar"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_brutal_crema"
                android:gravity="center_vertical"
                android:hint="Repite tu contraseña"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:paddingBottom="5dp"
                android:paddingEnd="15dp"
                android:paddingStart="15dp"
                android:singleLine="true"
                android:textColor="@color/tinta"
                android:textColorHint="@color/texto_suave"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/colorRed"
                android:textSize="12sp"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_sombra"
                android:paddingEnd="5dp"
                android:layout_height="55dp"
                android:paddingBottom="5dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_registrar"
                    style="@style/Widget.PetGo.Button"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:stateListAnimator="@null"
                    android:text="Registrarme"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/verde_petgo"
                    app:cornerRadius="11dp"
                    app:strokeColor="@color/tinta"
                    app:strokeWidth="2dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_ir_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:text="¿Ya tienes una cuenta?"
                android:textColor="@color/azul_enlace"
                android:textSize="14sp"
                android:textStyle="bold"
                android:minHeight="48dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
