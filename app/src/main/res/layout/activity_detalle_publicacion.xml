<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crema"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_marginTop="4dp"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@color/crema"
        app:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back_cabecera"
        app:title="Detalle"
        app:titleTextAppearance="@style/TextAppearance.AdopcionesTitle"
        app:contentInsetStartWithNavigation="6dp"
        app:titleTextColor="@color/tinta" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="180dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/img_foto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_card_image"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.PetGo.Photo"
                    app:strokeColor="@color/tinta"
                    app:strokeWidth="2dp"
                    android:contentDescription="Foto de la mascota" />

                <TextView
                    android:id="@+id/tv_placeholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textSize="48sp" />

                <TextView
                    android:id="@+id/tv_estado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_species_tag"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_nombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/tinta"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_tipo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/texto_suave"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_descripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/texto_suave"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_detalles_mascota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chip"
                android:padding="10dp"
                android:textColor="@color/tinta"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_resumen_actividad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_brutal_blanco"
                android:padding="10dp"
                android:textColor="@color/texto_suave"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Ubicacion"
                android:textColor="@color/texto_suave"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_ubicacion"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_chip"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/azul_enlace"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_fecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/texto_suave"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_fecha_perdida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/tinta"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_recompensa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/verde_petgo"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_historial_avistamientos"
                style="@style/Widget.PetGo.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:text="Ver historial de avistamientos"
                android:textAllCaps="false"
                android:textColor="@color/tinta"
                android:textSize="12sp"
                android:visibility="gone"
                app:backgroundTint="@color/white"
                app:cornerRadius="11dp"
                app:strokeColor="@color/tinta"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_avistamiento"
                style="@style/Widget.PetGo.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="Registrar avistamiento"
                android:textColor="@color/petgo_button_text"
                android:textSize="13sp"
                android:visibility="gone"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:backgroundTint="@color/amarillo"
                app:cornerRadius="11dp"
                app:strokeColor="@color/tinta"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_contactar"
                style="@style/Widget.PetGo.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="Contactar por WhatsApp"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:visibility="gone"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:backgroundTint="@color/verde_petgo"
                app:cornerRadius="11dp"
                app:strokeColor="@color/tinta"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_compartir"
                style="@style/Widget.PetGo.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="Compartir"
                android:textColor="@color/petgo_button_text"
                android:textSize="13sp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:backgroundTint="@color/white"
                app:cornerRadius="11dp"
                app:strokeColor="@color/tinta"
                app:strokeWidth="2dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
