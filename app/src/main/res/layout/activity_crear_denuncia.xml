<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/crema" android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_marginTop="12dp"
        android:layout_width="0dp"
        android:layout_height="52dp" android:background="@color/crema"
        app:elevation="0dp" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back_cabecera" app:title="Denunciar"
        app:titleTextAppearance="@style/TextAppearance.AdopcionesTitle"
        app:contentInsetStartWithNavigation="6dp"
        app:titleTextColor="@color/tinta" />

    <ScrollView android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Motivo" android:textColor="@color/tinta" android:textSize="13sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal">
                <TextView android:id="@+id/chip_maltrato" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:background="@drawable/bg_chip_selected"
                    android:paddingStart="16dp" android:paddingTop="8dp" android:paddingEnd="20dp"
                    android:paddingBottom="12dp" android:text="Maltrato" android:textColor="@color/tinta" android:textSize="13sp" />
                <TextView android:id="@+id/chip_abandono" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip" android:paddingStart="16dp"
                    android:paddingTop="8dp" android:paddingEnd="20dp" android:paddingBottom="12dp"
                    android:text="Abandono" android:textColor="@color/texto_suave" android:textSize="13sp" />
                <TextView android:id="@+id/chip_venta" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip" android:paddingStart="16dp"
                    android:paddingTop="8dp" android:paddingEnd="20dp" android:paddingBottom="12dp"
                    android:text="Venta ilegal" android:textColor="@color/texto_suave" android:textSize="13sp" />
                <TextView android:id="@+id/chip_otro" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip" android:paddingStart="16dp"
                    android:paddingTop="8dp" android:paddingEnd="20dp" android:paddingBottom="12dp"
                    android:text="Otro" android:textColor="@color/texto_suave" android:textSize="13sp" />
            </LinearLayout>

            <EditText android:id="@+id/et_motivo_custom" android:layout_width="match_parent"
                android:layout_height="50dp" android:layout_marginTop="8dp"
                android:background="@drawable/bg_brutal_blanco"
                android:gravity="center_vertical"
                android:hint="Escribe el motivo" android:importantForAutofill="no"
                android:inputType="text" android:paddingBottom="5dp"
                android:paddingStart="15dp" android:paddingEnd="20dp"
                android:singleLine="true" android:textColor="@color/tinta"
                android:textColorHint="@color/texto_suave" android:textSize="14sp"
                android:visibility="gone" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="Descripción" android:textColor="@color/tinta"
                android:textSize="13sp" android:textStyle="bold" />
            <EditText android:id="@+id/et_descripcion" android:layout_width="match_parent"
                android:layout_height="100dp" android:layout_marginTop="8dp"
                android:background="@drawable/bg_brutal_blanco" android:gravity="top|start"
                android:hint="Describe la situación" android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="19dp"
                android:paddingBottom="19dp"
                android:textColor="@color/tinta" android:textSize="14sp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="Foto (opcional)" android:textColor="@color/tinta"
                android:textSize="13sp" android:textStyle="bold" />
            <FrameLayout android:id="@+id/contenedor_foto" android:layout_width="96dp"
                android:layout_height="96dp" android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_image" android:clickable="true">
                <ImageView android:id="@+id/img_foto" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:scaleType="centerCrop" />
                <TextView android:id="@+id/tv_foto_hint" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="center"
                    android:text="📷\nAgregar foto" android:textColor="@color/texto_suave" android:textSize="11sp" />
            </FrameLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="Ubicación" android:textColor="@color/tinta"
                android:textSize="13sp" android:textStyle="bold" />
            <org.osmdroid.views.MapView android:id="@+id/mapa_denuncia"
                android:layout_width="match_parent" android:layout_height="200dp"
                android:layout_marginTop="8dp" android:background="@color/bg_divider" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="Toca el mapa para elegir la ubicación"
                android:textColor="@color/texto_suave" android:textSize="12sp" />

            <TextView android:id="@+id/tv_error" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:textColor="#E53935" android:textSize="12sp" android:visibility="gone" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_sombra"
                android:paddingEnd="5dp">

                <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_enviar" style="@style/Widget.Material3.Button"
                android:layout_width="match_parent" android:layout_height="50dp" android:text="Enviar denuncia"
                 android:textSize="14sp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/tinta"
                app:backgroundTint="@color/tarjeta_amarilla"
                app:cornerRadius="11dp"
                app:strokeColor="@color/tinta"
                app:strokeWidth="2dp"  />

            </FrameLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

