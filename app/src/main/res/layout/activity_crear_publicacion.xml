<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crema"
    android:fitsSystemWindows="true"
    tools:context=".CrearPublicacionActivity">


    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_marginTop="4dp"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@color/crema"
        app:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back_cabecera"
        app:title="Publicar"
        app:titleTextAppearance="@style/TextAppearance.AdopcionesTitle"
        app:contentInsetStartWithNavigation="6dp"
        app:titleTextColor="@color/tinta" />

    <ScrollView
        android:id="@+id/scroll_formulario"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/footer_publicar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Completa los datos y marca la ubicación en el mapa."
                android:textColor="@color/texto_suave"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_estado_red"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_chip"
                android:padding="10dp"
                android:text="Sin conexión: puedes seguir completando el borrador en este teléfono."
                android:textColor="@color/tinta"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_info_borrador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="El formulario se guarda como borrador privado en este teléfono. Solo se publica cuando tocas Publicar."
                android:textColor="@color/texto_suave"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_brutal_blanco"
                android:padding="12dp"
                android:textColor="@color/colorRed"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo de publicación"
                android:textColor="@color/tinta"
                android:textSize="13sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none"
                android:requiresFadingEdge="horizontal"
                android:fadingEdgeLength="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_perdida"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_selected"
                        android:paddingStart="16dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="12dp"
                        android:text="Perdida"
                        android:textColor="@color/tinta"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chip_encontrada"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_chip"
                        android:paddingStart="16dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="12dp"
                        android:text="Encontrada"
                        android:textColor="@color/texto_suave"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chip_adopcion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_chip"
                        android:paddingStart="16dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="12dp"
                        android:text="Adopción"
                        android:textColor="@color/texto_suave"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chip_denuncia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_chip"
                        android:paddingStart="16dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="12dp"
                        android:text="Denuncia"
                        android:textColor="@color/texto_suave"
                        android:textSize="13sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/section_motivos_denuncia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Motivo"
                    android:textColor="@color/tinta"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none"
                    android:fillViewport="true"
                    android:requiresFadingEdge="horizontal"
                    android:fadingEdgeLength="16dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_maltrato"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_selected"
                            android:paddingStart="16dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="20dp"
                            android:paddingBottom="12dp"
                            android:text="Maltrato"
                            android:textColor="@color/tinta"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/chip_abandono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip"
                            android:paddingStart="16dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="20dp"
                            android:paddingBottom="12dp"
                            android:text="Abandono"
                            android:textColor="@color/texto_suave"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/chip_venta_ilegal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip"
                            android:paddingStart="16dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="20dp"
                            android:paddingBottom="12dp"
                            android:text="Venta ilegal"
                            android:textColor="@color/texto_suave"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/chip_motivo_otro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip"
                            android:paddingStart="16dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="20dp"
                            android:paddingBottom="12dp"
                            android:text="Otro"
                            android:textColor="@color/texto_suave"
                            android:textSize="13sp" />

                    </LinearLayout>
                </HorizontalScrollView>

                <EditText
                    android:id="@+id/et_motivo_custom"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_brutal_blanco"
                    android:gravity="center_vertical"
                    android:hint="Escribe el motivo"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:paddingBottom="5dp"
                    android:paddingStart="15dp"
                    android:paddingEnd="20dp"
                    android:singleLine="true"
                    android:textColor="@color/tinta"
                    android:textColorHint="@color/texto_suave"
                    android:textSize="14sp"
                    android:visibility="gone" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/section_datos_perdida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="¿Cuándo la viste por última vez?"
                    android:textColor="@color/tinta"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_fecha_perdida"
                    style="Widget.PetGo.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="7dp"
                    android:text="Última vez: hoy"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="11dp"
                    app:strokeColor="@color/tinta"
                    app:strokeWidth="1dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Recompensa (opcional)"
                    android:textColor="@color/tinta"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_recompensa"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_brutal_blanco"
                    android:gravity="center_vertical"
                    android:hint="Ej. S/ 200 (acuerda la entrega con cuidado)"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLength="120"
                    android:paddingStart="15dp"
                    android:paddingEnd="20dp"
                    android:textColor="@color/tinta"
                    android:textColorHint="@color/texto_suave"
                    android:textSize="14sp" />
            </LinearLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Detalles de la publicación"
                android:textColor="@color/tinta"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Foto (opcional)"
                android:textColor="@color/tinta"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="La foto es opcional; si no se puede procesar, la publicación igual se guarda."
                android:textColor="@color/texto_suave"
                android:textSize="12sp" />

            <FrameLayout
                android:id="@+id/contenedor_foto"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_image"
                android:clickable="true"
                android:focusable="true">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/img_foto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.PetGo.Photo"
                    app:strokeColor="@color/tinta"
                    app:strokeWidth="2dp"
                    android:contentDescription="Foto de la mascota" />

                <TextView
                    android:id="@+id/tv_foto_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="📷\nAgregar foto"
                    android:textColor="@color/texto_suave"
                    android:textSize="11sp"
                    android:gravity="center" />
            </FrameLayout>


            <TextView
                android:id="@+id/label_nombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Nombre de la mascota"
                android:textColor="@color/tinta"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_nombre"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_brutal_blanco"
                android:gravity="center_vertical"
                android:hint="Ej. Max, Luna..."
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingBottom="5dp"
                android:paddingStart="15dp"
                android:paddingEnd="20dp"
                android:singleLine="true"
                android:textColor="@color/tinta"
                android:textColorHint="@color/texto_suave"
                android:textSize="14sp" />


            <TextView
                android:id="@+id/label_especie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Especie"
                android:textColor="@color/tinta"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/section_especie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_especie_perro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_selected"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="12dp"
                    android:text="Perro"
                    android:textColor="@color/tinta"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chip_especie_gato"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="12dp"
                    android:text="Gato"
                    android:textColor="@color/texto_suave"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/section_identificativos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Señas para reconocerla (opcionales)"
                    android:textColor="@color/tinta"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/et_color_mascota"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_brutal_blanco"
                        android:hint="Color"
                        android:importantForAutofill="no"
                        android:inputType="textCapSentences"
                        android:maxLength="60"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/tinta"
                        android:textColorHint="@color/texto_suave"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/et_tamano_mascota"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_brutal_blanco"
                        android:hint="Tamaño"
                        android:importantForAutofill="no"
                        android:inputType="textCapSentences"
                        android:maxLength="40"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/tinta"
                        android:textColorHint="@color/texto_suave"
                        android:textSize="13sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_senas_mascota"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_brutal_blanco"
                    android:gravity="top|start"
                    android:hint="Collar, manchas, cicatrices u otra seña particular"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="180"
                    android:padding="12dp"
                    android:textColor="@color/tinta"
                    android:textColorHint="@color/texto_suave"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/section_adopcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Información para adoptantes (opcional)"
                    android:textColor="@color/tinta"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_edad_adopcion"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_brutal_blanco"
                    android:hint="Edad aproximada (ej. 2 años, cachorro)"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLength="40"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/tinta"
                    android:textColorHint="@color/texto_suave"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_caracter_adopcion"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_brutal_blanco"
                    android:hint="Carácter (ej. cariñoso, tranquilo, juguetón)"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLength="80"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/tinta"
                    android:textColorHint="@color/texto_suave"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_cuidados_adopcion"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_brutal_blanco"
                    android:gravity="top|start"
                    android:hint="Cuidados importantes (vacunas, alimentación, paseos)"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="180"
                    android:padding="12dp"
                    android:textColor="@color/tinta"
                    android:textColorHint="@color/texto_suave"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/section_ultimo_lugar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Última vez visto (opcional)"
                    android:textColor="@color/tinta"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_ultimo_lugar"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_brutal_blanco"
                    android:gravity="center_vertical"
                    android:hint="Ej. parque o barrio; evita poner una dirección exacta"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:paddingBottom="5dp"
                    android:paddingStart="15dp"
                    android:paddingEnd="20dp"
                    android:singleLine="true"
                    android:textColor="@color/tinta"
                    android:textColorHint="@color/texto_suave"
                    android:textSize="14sp" />

            </LinearLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Descripción"
                android:textColor="@color/tinta"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_descripcion"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_brutal_blanco"
                android:gravity="top|start"
                android:hint="Color, tamaño, raza, collar y marcas que ayuden a reconocerla"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="19dp"
                android:paddingBottom="19dp"
                android:textColor="@color/tinta"
                android:textColorHint="@color/texto_suave"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/section_contacto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WhatsApp de contacto (opcional)"
                    android:textColor="@color/tinta"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_contacto_whatsapp"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_brutal_blanco"
                    android:hint="9 dígitos; permite iniciar un chat desde PetGo"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:paddingStart="15dp"
                    android:paddingEnd="20dp"
                    android:textColor="@color/tinta"
                    android:textColorHint="@color/texto_suave"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_contacto_privacidad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Opcional. Si agregas tu número, las personas que consulten el aviso podrán contactarte por WhatsApp. Al tocar el botón, WhatsApp se abrirá con ese número. Si lo dejas vacío, el botón no aparecerá; en adopciones podrán enviarte una solicitud desde PetGo."
                    android:textColor="@color/texto_suave"
                    android:textSize="12sp" />
            </LinearLayout>


            <TextView
                android:id="@+id/label_ubicacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Ubicación"
                android:textColor="@color/tinta"
                android:textSize="13sp"
                android:textStyle="bold" />

            <org.osmdroid.views.MapView
                android:id="@+id/mapa_crear"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="8dp"
                android:background="@color/bg_divider" />

            <TextView
                android:id="@+id/hint_ubicacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="📍 Toca el mapa para elegir la ubicación"
                android:textColor="@color/texto_suave"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_chip"
                android:padding="10dp"
                android:text="Por privacidad, el mapa público muestra una zona aproximada de unos 100 m. El punto exacto solo queda guardado para ti. Marca un lugar público cercano, nunca tu domicilio."
                android:textColor="@color/tinta"
                android:textSize="12sp" />


        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/footer_publicar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/crema"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/bg_sombra"
            android:paddingEnd="5dp"
            android:paddingBottom="5dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_publicar"
                style="@style/Widget.PetGo.Button"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:stateListAnimator="@null"
                android:text="Publicar"
                android:textAllCaps="false"
                android:textColor="@color/petgo_button_text"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/tarjeta_amarilla"
                app:cornerRadius="11dp"
                app:strokeColor="@color/tinta"
                app:strokeWidth="2dp" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>


