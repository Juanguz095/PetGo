<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crema"
    android:fitsSystemWindows="true"
    tools:context=".AdopcionesActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@color/crema"
        android:elevation="0dp"
        app:contentInsetStart="8dp"
        app:contentInsetStartWithNavigation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back_cabecera"
        app:title="Adopciones"
        app:titleTextAppearance="@style/TextAppearance.AdopcionesTitle"
        app:titleTextColor="@color/tinta">

        <LinearLayout
            android:id="@+id/btn_favoritos"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_icono_cabecera"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❤"
                android:textColor="@color/colorRed"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_fav_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="3dp"
                android:text="0"
                android:textColor="@color/tinta"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="14dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_filtro" />

                    <TextView
                        android:id="@+id/chip_todos"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginEnd="9dp"
                        android:background="@drawable/bg_chip_selected"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingTop="0dp"
                        android:paddingEnd="22dp"
                        android:paddingBottom="4dp"
                        android:text="Todas"
                        android:textColor="@color/tinta"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chip_perros"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginEnd="9dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingTop="0dp"
                        android:paddingEnd="22dp"
                        android:paddingBottom="4dp"
                        android:text="Perros"
                        android:textColor="@color/tinta"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chip_gatos"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingTop="0dp"
                        android:paddingEnd="22dp"
                        android:paddingBottom="4dp"
                        android:text="Gatos"
                        android:textColor="@color/tinta"
                        android:textSize="13sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_buscar"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_field"
                    android:drawableStart="@drawable/ic_buscar"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:hint="Buscar por nombre, especie o raza"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingTop="0dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="5dp"
                    android:singleLine="true"
                    android:textColor="@color/tinta"
                    android:textColorHint="@color/texto_suave"
                    android:textSize="14sp" />

                <FrameLayout
                    android:layout_marginStart="8dp"
                    android:layout_width="61dp"
                    android:background="@drawable/bg_sombra"
                    android:paddingEnd="5dp"
                    android:layout_height="61dp"
                    android:paddingBottom="5dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/fab_agregar"
                        style="@style/Widget.PetGo.Button.Icon"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:contentDescription="Agregar mascota en adopcion"
                        app:icon="@drawable/ic_fab_menu"
                        app:backgroundTint="@color/petgo_button_background" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_opciones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="0 opciones para adoptar"
                android:textColor="@color/texto_suave"
                android:textSize="13sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none"
                android:fillViewport="true"
                android:requiresFadingEdge="horizontal"
                android:fadingEdgeLength="16dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_orden_recientes"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_chip_selected"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingTop="0dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="4dp"
                        android:text="Recientes"
                        android:textColor="@color/tinta"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chip_orden_cercanos"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="9dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingTop="0dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="4dp"
                        android:text="Más cercanos"
                        android:textColor="@color/tinta"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chip_orden_nombre"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="9dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingTop="0dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="4dp"
                        android:text="Nombre"
                        android:textColor="@color/tinta"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tv_vacio"
                style="@style/Widget.PetGo.EmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/no_adoption_results"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_animales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingEnd="5dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="24dp"
                android:background="@color/tinta" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="¿Cómo funciona la adopción?"
                android:textColor="@color/tinta"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_step_circle"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/tinta"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Encuentra"
                        android:textColor="@color/texto_suave"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="→"
                    android:textColor="@color/tinta"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_step_circle"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="@color/tinta"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Conoce"
                        android:textColor="@color/texto_suave"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="→"
                    android:textColor="@color/tinta"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_step_circle"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@color/tinta"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Visita"
                        android:textColor="@color/texto_suave"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="→"
                    android:textColor="@color/tinta"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_step_circle"
                        android:gravity="center"
                        android:text="4"
                        android:textColor="@color/tinta"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Adopta"
                        android:textColor="@color/texto_suave"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_proceso"
                style="@style/Widget.PetGo.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Conocer el proceso completo"
                android:textColor="@color/petgo_button_text"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/tinta"
                app:strokeWidth="2dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
