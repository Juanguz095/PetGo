<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crema"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />


    <TextView
        android:id="@+id/tv_pista_publicar"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_chip_map"
        android:elevation="2dp"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:text="Mantén presionado el mapa para publicar"
        android:textColor="@color/texto_suave"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="0dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@id/controls_recenter"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp" />


    <TextView
        android:id="@+id/btn_leyenda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_chip_map"
        android:elevation="2dp"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:text="📖  Leyenda"
        android:textColor="@color/tinta"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_pista_publicar"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:paddingEnd="16dp"
        android:paddingBottom="9dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground" />


    <TextView
        android:id="@+id/btn_cercanas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_chip_map"
        android:elevation="2dp"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:text="Alertas cerca"
        android:textColor="@color/tinta"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_leyenda"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:paddingEnd="16dp"
        android:paddingBottom="9dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground" />


    <TextView
        android:id="@+id/btn_notificaciones"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_chip_map"
        android:elevation="2dp"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:text="🔔  Notificaciones"
        android:textColor="@color/tinta"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_cercanas"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:paddingEnd="16dp"
        android:paddingBottom="9dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground" />


    <FrameLayout
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="61dp"
        android:background="@drawable/bg_sombra"
        android:paddingEnd="5dp"
        android:layout_height="61dp"
        android:paddingBottom="5dp"
        android:id="@+id/controls_recenter">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/fab_recenter"
            style="@style/Widget.PetGo.Button.Icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="Recentrar"
            app:icon="@drawable/ic_recenter" />
    </FrameLayout>



    <LinearLayout
        android:id="@+id/panel_alerta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel_top"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/panel_cerrar"
                android:background="@drawable/bg_circle_rojo"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Cerrar detalle"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/panel_foto"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_card_image"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="Foto de la mascota"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.PetGo.Photo"
            app:strokeColor="@color/tinta"
            app:strokeWidth="2dp" />

        <TextView
            android:id="@+id/panel_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pill_estado"
            android:paddingStart="12dp"
            android:paddingTop="3dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/panel_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/tinta"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/panel_tipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/texto_suave"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/panel_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/texto_suave"
            android:textSize="13sp"
            android:maxLines="3"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/panel_ubicacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/texto_suave"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/panel_estado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/panel_compartir"
                style="@style/Widget.PetGo.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Compartir"
                android:textColor="@color/petgo_button_text"
                android:textSize="12sp"
                app:cornerRadius="11dp"
                app:strokeColor="@color/tinta"
                app:strokeWidth="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panel_botones_tipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/panel_btn_izq"
                style="@style/Widget.PetGo.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textColor="@color/petgo_button_text"
                android:textSize="12sp"
                app:cornerRadius="11dp"
                app:strokeColor="@color/tinta"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/panel_btn_der"
                style="@style/Widget.PetGo.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textColor="@color/petgo_button_text"
                android:textSize="12sp"
                android:visibility="gone"
                app:cornerRadius="11dp"
                app:strokeColor="@color/tinta"
                app:strokeWidth="2dp" />
        </LinearLayout>
    </LinearLayout>


    <LinearLayout
        android:id="@+id/zoom_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:layout_width="53dp"
            android:background="@drawable/bg_sombra"
            android:paddingEnd="5dp"
            android:layout_height="53dp"
            android:paddingBottom="5dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/fab_zoom_in"
                style="@style/Widget.PetGo.Button.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Acercar"
                app:icon="@drawable/ic_fab_menu" />
        </FrameLayout>

        <FrameLayout
            android:layout_marginStart="8dp"
            android:layout_width="53dp"
            android:background="@drawable/bg_sombra"
            android:paddingEnd="5dp"
            android:layout_height="53dp"
            android:paddingBottom="5dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/fab_zoom_out"
                style="@style/Widget.PetGo.Button.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Alejar"
                app:icon="@drawable/ic_menos" />
        </FrameLayout>
    </LinearLayout>


    <FrameLayout
        android:layout_marginStart="16dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="61dp"
        android:background="@drawable/bg_sombra"
        android:paddingEnd="5dp"
        android:layout_height="61dp"
        android:paddingBottom="5dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/fab_perfil"
            style="@style/Widget.PetGo.Button.Icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="Perfil"
            app:icon="@drawable/ic_perfil" />
    </FrameLayout>


    <FrameLayout
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="61dp"
        android:background="@drawable/bg_sombra"
        android:paddingEnd="5dp"
        android:layout_height="61dp"
        android:paddingBottom="5dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/fab_menu"
            style="@style/Widget.PetGo.Button.Icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="Menú de opciones"
            app:icon="@drawable/ic_fab_menu"
            app:backgroundTint="@color/petgo_button_background" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

