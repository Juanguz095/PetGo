<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crema"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />


    <TextView
        android:id="@+id/tv_pista_publicar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_chip_map"
        android:elevation="2dp"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:text="Mantén pulsado para publicar"
        android:textColor="@color/texto_suave"
        android:textSize="11sp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/controls_recenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_toggle_controles_mapa"
        style="@style/Widget.PetGo.Button.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="Mostrar controles del mapa"
        android:ellipsize="end"
        android:maxLines="1"
        android:minWidth="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Opciones del mapa"
        android:textSize="12sp"
        app:icon="@drawable/ic_menu_grid"
        app:iconGravity="textStart"
        app:iconSize="18dp"
        app:iconPadding="6dp"
        app:iconTint="@color/tinta"
        app:layout_constraintEnd_toStartOf="@id/controls_recenter"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/panel_controles_mapa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card_lista"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="4dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_toggle_controles_mapa">

        <HorizontalScrollView
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:requiresFadingEdge="horizontal"
            android:fadingEdgeLength="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/filtro_todas"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_chip_selected"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Todas"
                    android:textColor="@color/tinta"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/filtro_perdidas"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Perdidas"
                    android:textColor="@color/texto_suave"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/filtro_encontradas"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Encontradas"
                    android:textColor="@color/texto_suave"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/filtro_adopciones"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Adopciones"
                    android:textColor="@color/texto_suave"
                    android:textSize="13sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="4dp"
            android:background="@color/bg_divider" />

        <TextView
            android:id="@+id/btn_leyenda"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="12dp"
            android:text="📖  Leyenda"
            android:textColor="@color/tinta"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@color/bg_divider" />

        <TextView
            android:id="@+id/btn_cercanas"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="12dp"
            android:text="Alertas cerca"
            android:textColor="@color/tinta"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <View
            android:id="@+id/divisor_alertas_mapa"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@color/bg_divider"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_notificaciones"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="12dp"
            android:text="🔔  Notificaciones"
            android:textColor="@color/tinta"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>


    <FrameLayout
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="53dp"
        android:background="@drawable/bg_sombra"
        android:paddingEnd="5dp"
        android:layout_height="53dp"
        android:paddingBottom="5dp"
        android:id="@+id/controls_recenter">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/fab_recenter"
            style="@style/Widget.PetGo.Button.Icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Seguir mi ubicación"
                app:icon="@drawable/ic_my_location" />
    </FrameLayout>



    <LinearLayout
        android:id="@+id/panel_alerta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel_top"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/panel_cerrar"
                android:background="@drawable/bg_circle_rojo"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Cerrar detalle"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/panel_foto"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="0dp"
            android:background="@drawable/bg_card_image"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="Foto de la mascota"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.PetGo.Photo"
            app:strokeColor="@color/tinta"
            app:strokeWidth="2dp" />

        <TextView
            android:id="@+id/panel_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pill_estado"
            android:paddingStart="12dp"
            android:paddingTop="3dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/panel_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/tinta"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/panel_tipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/texto_suave"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/panel_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/texto_suave"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/panel_ubicacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/texto_suave"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/panel_estado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/panel_compartir"
                style="@style/Widget.PetGo.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Compartir"
                android:textColor="@color/petgo_button_text"
                android:textSize="12sp"
                app:cornerRadius="11dp"
                app:strokeColor="@color/tinta"
                app:strokeWidth="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panel_botones_tipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/panel_btn_izq"
                style="@style/Widget.PetGo.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textColor="@color/petgo_button_text"
                android:textSize="12sp"
                app:cornerRadius="11dp"
                app:strokeColor="@color/tinta"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/panel_btn_der"
                style="@style/Widget.PetGo.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textColor="@color/petgo_button_text"
                android:textSize="12sp"
                android:visibility="gone"
                app:cornerRadius="11dp"
                app:strokeColor="@color/tinta"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/panel_btn_extra"
                style="@style/Widget.PetGo.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:textColor="@color/petgo_button_text"
                android:textSize="10sp"
                android:visibility="gone"
                app:cornerRadius="11dp"
                app:strokeColor="@color/tinta"
                app:strokeWidth="2dp" />
        </LinearLayout>
    </LinearLayout>


    <LinearLayout
        android:id="@+id/zoom_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:layout_width="53dp"
            android:background="@drawable/bg_sombra"
            android:paddingEnd="5dp"
            android:layout_height="53dp"
            android:paddingBottom="5dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/fab_zoom_in"
                style="@style/Widget.PetGo.Button.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Acercar"
                app:icon="@drawable/ic_zoom_in" />
        </FrameLayout>

        <FrameLayout
            android:layout_marginStart="8dp"
            android:layout_width="53dp"
            android:background="@drawable/bg_sombra"
            android:paddingEnd="5dp"
            android:layout_height="53dp"
            android:paddingBottom="5dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/fab_zoom_out"
                style="@style/Widget.PetGo.Button.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Alejar"
                app:icon="@drawable/ic_zoom_out" />
        </FrameLayout>
    </LinearLayout>


    <FrameLayout
        android:layout_marginStart="16dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="53dp"
        android:background="@drawable/bg_sombra"
        android:paddingEnd="5dp"
        android:layout_height="53dp"
        android:paddingBottom="5dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/fab_perfil"
            style="@style/Widget.PetGo.Button.Icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Perfil"
            app:icon="@drawable/ic_perfil" />
    </FrameLayout>


    <FrameLayout
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="53dp"
        android:background="@drawable/bg_sombra"
        android:paddingEnd="5dp"
        android:layout_height="53dp"
        android:paddingBottom="5dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/fab_menu"
            style="@style/Widget.PetGo.Button.Icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Menú de opciones"
            app:icon="@drawable/ic_menu_grid"
            app:backgroundTint="@color/petgo_button_background" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

