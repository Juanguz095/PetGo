<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crema"
    tools:context=".ReportarAvistamientoActivity"
    android:fitsSystemWindows="true">


    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_marginTop="4dp"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@color/crema"
        app:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back_cabecera"
        app:title="Reportar avistamiento"
        app:titleTextAppearance="@style/TextAppearance.AdopcionesTitle"
        app:contentInsetStartWithNavigation="6dp"
        app:titleTextColor="@color/tinta" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_estado_red"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_chip"
                android:padding="10dp"
                android:text="Sin conexión. Podrás enviar el avistamiento cuando recuperes internet."
                android:textColor="@color/tinta"
                android:textSize="12sp"
                android:visibility="gone" />


            <TextView
                android:id="@+id/tv_mascota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tinta"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_alerta_relacionada"
                style="Widget.PetGo.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="Vincular con una alerta perdida (opcional)"
                android:textAllCaps="false"
                android:textSize="12sp"
                app:backgroundTint="@color/white"
                app:cornerRadius="11dp"
                app:strokeColor="@color/tinta"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_especie_avistamiento"
                style="Widget.PetGo.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:text="Especie: Perro"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:visibility="gone"
                app:backgroundTint="@color/white"
                app:cornerRadius="11dp"
                app:strokeColor="@color/tinta"
                app:strokeWidth="1dp" />

            <TextView
                android:id="@+id/tv_ayuda_ubicacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="¿Dónde la viste? Toca el mapa para indicarlo"
                android:textColor="@color/texto_suave"
                android:textSize="12sp" />

            <org.osmdroid.views.MapView
                android:id="@+id/mapa_avistamiento"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="12dp"
                android:background="@color/bg_divider" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_info_seguridad"
                style="@style/Widget.PetGo.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:text="Información de seguridad"
                android:textAllCaps="false"
                android:textSize="12sp"
                app:backgroundTint="@color/white"
                app:cornerRadius="11dp"
                app:icon="@drawable/ic_info_outline"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:iconTint="@color/azul_enlace"
                app:strokeColor="@color/tinta"
                app:strokeWidth="1dp" />

            <TextView
                android:id="@+id/tv_info_seguridad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chip"
                android:padding="12dp"
                android:text="Por seguridad, no persigas al animal ni te acerques al tráfico. El mapa mostrará una zona aproximada; solo quien reporta y el dueño verán el punto exacto. La foto y los detalles serán visibles para usuarios de PetGo con sesión. La foto es opcional y el reporte se guarda aunque no pueda procesarse. Si no encuentras la alerta, puedes dejarlo sin vincular; el dueño podrá asociarlo después."
                android:textColor="@color/tinta"
                android:textSize="12sp"
                android:visibility="gone" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="¿Cuándo la viste?"
                android:textColor="@color/tinta"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_hora_avistamiento"
                style="Widget.PetGo.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:text="La vi: ahora"
                android:textAllCaps="false"
                android:textColor="@color/tinta"
                app:backgroundTint="@color/white"
                app:cornerRadius="11dp"
                app:strokeColor="@color/tinta"
                app:strokeWidth="1dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Foto del avistamiento (opcional)"
                android:textColor="@color/tinta"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/contenedor_foto_avist"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_image"
                android:clickable="true"
                android:focusable="true">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/img_foto_avist"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Foto del avistamiento"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.PetGo.Photo"
                    app:strokeColor="@color/tinta"
                    app:strokeWidth="2dp" />

                <TextView
                    android:id="@+id/tv_foto_hint_avist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="📷\nAgregar foto"
                    android:textColor="@color/texto_suave"
                    android:textSize="11sp"
                    android:gravity="center" />
            </FrameLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Detalle (opcional)"
                android:textColor="@color/tinta"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_descripcion"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_brutal_blanco"
                android:gravity="top|start"
                android:hint="Color, collar, dirección o si todavía está allí"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:maxLength="1000"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="19dp"
                android:paddingBottom="19dp"
                android:textColor="@color/tinta"
                android:textColorHint="@color/texto_suave"
                android:textSize="14sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_sombra"
                android:paddingEnd="5dp"
                android:layout_height="55dp"
                android:paddingBottom="5dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reportar"
                    style="@style/Widget.PetGo.Button"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Reportar avistamiento"
                    android:textSize="14sp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:stateListAnimator="@null"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="@color/petgo_button_text"
                    app:backgroundTint="@color/tarjeta_amarilla"
                    app:cornerRadius="11dp"
                    app:strokeColor="@color/tinta"
                    app:strokeWidth="2dp"  />

            </FrameLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>


