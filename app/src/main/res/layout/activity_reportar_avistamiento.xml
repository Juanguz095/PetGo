<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crema"
    tools:context=".ReportarAvistamientoActivity"
    android:fitsSystemWindows="true">


    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_marginTop="12dp"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@color/crema"
        app:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back_cabecera"
        app:title="Reportar avistamiento"
        app:titleTextAppearance="@style/TextAppearance.AdopcionesTitle"
        app:contentInsetStartWithNavigation="6dp"
        app:titleTextColor="@color/tinta" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_mascota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tinta"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="¿Dónde la viste? Toca el mapa para indicarlo"
                android:textColor="@color/texto_suave"
                android:textSize="12sp" />

            <org.osmdroid.views.MapView
                android:id="@+id/mapa_avistamiento"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="12dp"
                android:background="@color/bg_divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="📍 Toca el mapa para elegir el lugar del avistamiento"
                android:textColor="@color/texto_suave"
                android:textSize="12sp" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Foto del avistamiento (opcional)"
                android:textColor="@color/tinta"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/contenedor_foto_avist"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_image"
                android:clickable="true"
                android:focusable="true">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/img_foto_avist"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Foto del avistamiento"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.PetGo.Photo"
                    app:strokeColor="@color/tinta"
                    app:strokeWidth="2dp" />

                <TextView
                    android:id="@+id/tv_foto_hint_avist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="📷\nAgregar foto"
                    android:textColor="@color/texto_suave"
                    android:textSize="11sp"
                    android:gravity="center" />
            </FrameLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Detalle (opcional)"
                android:textColor="@color/tinta"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_descripcion"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_brutal_blanco"
                android:gravity="top|start"
                android:hint="Ej. Lo vi cruzando la avenida con collar rojo"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="19dp"
                android:paddingBottom="19dp"
                android:textColor="@color/tinta"
                android:textColorHint="@color/texto_suave"
                android:textSize="14sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_sombra"
                android:paddingEnd="5dp"
                android:layout_height="55dp"
                android:paddingBottom="5dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reportar"
                    style="@style/Widget.PetGo.Button"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Reportar avistamiento"
                    android:textSize="14sp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:stateListAnimator="@null"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="@color/petgo_button_text"
                    app:backgroundTint="@color/tarjeta_amarilla"
                    app:cornerRadius="11dp"
                    app:strokeColor="@color/tinta"
                    app:strokeWidth="2dp"  />

            </FrameLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>


