<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crema"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".SplashActivity"
    android:fitsSystemWindows="true">

    <ImageView
        android:id="@+id/img_logo"
        android:layout_width="193dp"
        android:layout_height="193dp"
        android:background="@drawable/bg_brutal_blanco"
        android:contentDescription="@string/app_name"
        android:paddingBottom="7dp"
        android:paddingEnd="7dp"
        android:paddingStart="2dp"
        android:paddingTop="2dp"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_petgo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center"
        android:text="Juntos, cada mascota vuelve a"
        android:textColor="@color/tinta"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="casa"
        android:textColor="@color/verde_tagline"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="160dp"
        android:layout_height="6dp"
        android:layout_marginTop="32dp"
        android:max="100"
        android:progressBackgroundTint="@color/crema"
        android:progressTint="@color/verde_petgo"
        android:visibility="invisible"
        tools:visibility="visible" />

</LinearLayout>
